from My_scripts2.consts import *
from Compiler.library import *

N_THREADS = 4

def accept_client():
    client_socket_id = accept_client_connection(PORT_NUM)
    last = regint.read_from_socket(client_socket_id)
    return client_socket_id, last

def close_connection(num_clients):
    @for_range(num_clients)
    def _(i):
        closeclientconnection(i)

def get_client_input(client_socket_id):
    client_matrix = Matrix(NUM_CANDIDATES, NUM_CANDIDATES, sint).assign_all(0)
    
    received_values = sint.receive_from_client(1, client_socket_id, size = 1)[0]

    return received_values

def main():
    listen_for_clients(PORT_NUM)
    
    def do_stuff():
        client_sockets = Array(NUM_CLIENTS, regint)
        number_clients = MemValue(regint(0))
        client_ids = Array(NUM_CLIENTS, sint)
        inputs_seen = Array(NUM_CLIENTS, regint)
        inputs_seen.assign_all(0)

        @do_while
        def client_connections():
            client_id, last = accept_client()
            client_sockets[client_id] = client_id
            client_ids[client_id] = client_id
            inputs_seen[client_id] = 1
            @if_(last == 1)
            def _():
                number_clients.write(client_id + 1)
            return (sum(inputs_seen) < number_clients) + (number_clients == 0)
    
        def run():
            client_values = []

            @for_range_multithread(N_THREADS, 1, number_clients)
            def _(client_id):
                client_values.append(get_client_input(client_id))

            result = client_values[0]

            # reveal the result to servers
            result.reveal()

        run()
        close_connection(number_clients)

        return True
    
    do_stuff()

main()