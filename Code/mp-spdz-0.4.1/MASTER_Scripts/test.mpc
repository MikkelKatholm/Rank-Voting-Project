from Compiler.types import *
from Compiler.GC.types import *
from Compiler.library import print_ln, do_while, for_range
from Compiler.util import if_else

program.use_edabit(True)

sb = sbit.get_type(1)

a = sb(1)
b = sbit(1)

runs = 2**14
