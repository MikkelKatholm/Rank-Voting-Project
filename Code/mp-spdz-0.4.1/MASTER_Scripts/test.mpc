from Compiler.library import print_ln, do_while, for_range
from Compiler.util import if_else
from Compiler.library import start_timer, stop_timer

import MASTER_Scripts.test_1 as test_1

program.use_edabit(True)

sb = sbits.get_type(1)

def main():
    my_sint = sint(0)
    my_sbit = sbit(1)

    result = sint(0)
    for i in range(3000): 
        added = sint(sbit(1))
        result = result + added
    print_ln("Added: %s with type %s", result.reveal(), type(result))



main()