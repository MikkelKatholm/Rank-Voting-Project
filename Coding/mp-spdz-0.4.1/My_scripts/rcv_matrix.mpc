# secure_ballot.mpc
import os, sys
sys.path.insert(0, os.path.dirname(sys.argv[0]) + '/..')

from Compiler.library import *
from My_scripts.consts import *
from My_scripts.Shamir import Shamir

is_debug = True


def read_ballot_for_party(party_id: int) -> list[Matrix]:
    """ Create secret-shared ballots for all voters in a given party.
    
    :param party_id: The ID of the party for which to create ballots.
    :return: A list of NUM_VOTES_PER_PARTY[party_id] secret-shared ballot matrices.
    """
    num_votes = NUM_VOTES
    size_of_input = NUM_CANDIDATES * NUM_CANDIDATES * num_votes
    ballots: list[Matrix] = []

    flat_priorities = sint.get_input_from(party_id, size=size_of_input)

    # Build a ballot for each voter
    for voter_idx in range(num_votes):
        ballot  = Matrix(NUM_CANDIDATES, NUM_CANDIDATES, value_type=sint)
        for row in range(NUM_CANDIDATES):
            for col in range(NUM_CANDIDATES):
                index = voter_idx * NUM_CANDIDATES * NUM_CANDIDATES + row * NUM_CANDIDATES + col
                ballot[row][col] = flat_priorities[index]
        ballots.append(ballot)

    return ballots

def read_all_shamir_ballots() -> list[list[Matrix]]:
    """
    [p0_ballots, p1_ballots, p2_ballots]
    """
    all_ballots: list[list[Matrix]] = []
    for party_id in range(NUM_PARTIES):
        party_ballots = read_ballot_for_party(party_id)
        all_ballots.append(party_ballots)
    return all_ballots   

def read_all_ballots() -> list[Matrix]:
    """ Create secret-shared ballots for all voters across all parties.
    
    :return: A list of secret-shared ballot matrices for all voters.
    """
    all_ballots: list[Matrix] = []
    for party_id in range(NUM_PARTIES):
        party_ballots = read_ballot_for_party(party_id)
        all_ballots.extend(party_ballots)
    return all_ballots

def substract_until_zero_or_one_mod(x_in: sint, modulus: int) -> sint:
    # Compute remainder modulo the public modulus
    rem = x_in % sint(modulus)
    # If remainder == 0 → return 0 else 1
    return (rem == 0).if_else(0, 1)

def lagrange_interpolate_at_zero(x_values, y_values):
    n = NUM_SHARES
    result = sint(0)

    for i in range(n):
        numerator = sint(1)
        denominator = sint(1)
        xi = x_values[i]

        for j in range(n):
            if i != j:
                xj = x_values[j]
                numerator *= -xj
                denominator *= (xi - xj)
        
        Li = (numerator / denominator) # NOTE: needs to be in field (div_mod). Assuming FIELD_SIZE is prime.
        result += y_values[i] * Li
    return result



def my_mod(x_in, modulus):
    """Repeatedly subtract public 'modulus' from secret x_in until x is 0 or 1.
    Uses an Array(1, sint) as a mutable container and a bounded for_range loop
    (compile-time constant iterations) so the compiler does not need a clear
    secret condition. Adds debug prints when is_debug is True."""
    x = Array(1, sint)
    x[0] = x_in 

    # safe compile-time upper bound on number of subtractions
    # (FIELD_SIZE and modulus are Python ints from consts.py)
    if modulus <= 0:
        max_iters = FIELD_SIZE
    else:
        max_iters = (FIELD_SIZE // modulus) + 2

    @for_range(max_iters)
    def _(k):
        # comparison yields a secret bit (sintbit). Use its if_else to update x.
        cond = (x[0] != sint(0)) & (x[0] != sint(1))

        if is_debug:
            # reveal current secret values for debugging (will reconstruct to all parties)
            x_before = x[0].reveal()
            cond_before = cond.reveal()
            print_ln_to(0, 'my_mod iter %s before: x=%s cond=%s', k, x_before, cond_before)

        x[0].update(cond.if_else(x[0] - sint(modulus), x[0]))
    
        if is_debug:
            x_after = x[0].reveal()
            print_ln_to(0, 'my_mod iter %s after:  x=%s', k, x_after)

    return x[0]
def read_ballots_alt() -> list[Matrix]:
    ss_scheme = Shamir(NUM_SHARES, THRESHOLD, FIELD_SIZE)

    all_ballots = read_all_shamir_ballots()
    output_ballots = [Matrix(NUM_CANDIDATES, NUM_CANDIDATES, sint) for _ in range(NUM_VOTES)]

    x_values = Array(NUM_SHARES, sint).assign_all(0)
    for i in range(NUM_SHARES):
        x_values[i] = sint(i + 1)

    for voter_id in range(NUM_VOTES):
        for row in range(NUM_CANDIDATES):
            for col in range(NUM_CANDIDATES):
                shares = []
                for ballot_list in all_ballots:
                    shares.append(ballot_list[voter_id][row][col])
                
                # DO LAGRANGE INTERPOLATION HERE

                result_of_lagrange = lagrange_interpolate_at_zero(x_values, shares)

                output_ballots[voter_id][row][col] = result_of_lagrange

    return output_ballots

def remove_eliminated_candidates(ballot: Matrix, active_candidates: Array) -> Matrix:
    """ Remove eliminated candidates from the ballot matrix. 
    
    :param ballot: A NUM_CANDIDATES x NUM_CANDIDATES secret-shared ballot matrix.
    :param active_candidates: A list of 0/1 secret-shared bits indicating active candidates.
    :return: A modified ballot matrix with eliminated candidates removed.
    """

    for row in range(NUM_CANDIDATES):
        for col in range(NUM_CANDIDATES):
            ballot[row][col] = ballot[row][col] * active_candidates[row]
    return ballot

def remove_non_highest_priority(ballot: Matrix) -> Matrix:
    """ Remove non-highest priority candidates from the ballot matrix.
    
    :param ballot: A NUM_CANDIDATES x NUM_CANDIDATES secret-shared ballot matrix.
    :return: A modified ballot matrix with only the highest priority candidate retained.

    Example:
    >>> remove_non_highest_priority(ballot)
        If the ballot matrix is:
           [[0, 0, 0]  # Candidate 0 is eliminated
            [0, 0, 1]  # Candidate 1 has priority 2
            [1, 0, 0]] # Candidate 2 has priority 0
        Then the resulting ballot matrix will be:
            [[0, 0, 0]  # Candidate 0 is eliminated
             [0, 0, 0]  # Candidate 1 is not highest priority
             [1, 0, 0]] # Candidate 2 is highest priority
    """

    debug_print(ballot, "Before removing non-highest priority")

    found_highest = sint(1)
    @for_range(NUM_CANDIDATES)
    def _(col):
        @for_range(NUM_CANDIDATES)
        def _(row):
            is_highest = ballot[row][col] * (found_highest)
            ballot[row][col] = is_highest
            found_highest.update(found_highest - is_highest)

    debug_print(ballot, "After removing non-highest priority ")
    return ballot

def eliminate_candidate(active_candidates: Array, cand_id: sint) -> Array:
    """ Eliminate a candidate by setting their active flag to 0
    
    :param active_candidates: A list of 0/1 secret-shared bits indicating active candidates.
    :param cand_id: The candidate ID to eliminate.
    :return: Updated active_candidates list with the specified candidate eliminated.
    """
    # NOTE: does this mean that a party can see how is eliminated based on what value is changed in active_candidates?


    @for_range(NUM_CANDIDATES)
    def _(i):
        condition = (i == cand_id)
        active_candidates[i] = condition.if_else(sint(0), sint(1) * active_candidates[i])

    return active_candidates

def initialize_active_candidates():
    """ Initialize all candidates as active (1). 
    :return: A list of secret-shared bits indicating all candidates are active.
    """
    active_candidates = Array(NUM_CANDIDATES, sint)
    active_candidates.assign_all(sint(1))
    return active_candidates

def sum_rows(ballot: Matrix) -> Array:
    """ Sum each row of the ballot matrix.
    
    :param ballot: A NUM_CANDIDATES x NUM_CANDIDATES secret-shared ballot matrix.
    :return: An array of secret-shared integers representing the sum of each row.
    """
    sum_of_rows = Array(NUM_CANDIDATES, sint)

    for row in range(NUM_CANDIDATES):
        row_sum = sint(0)
        for col in range(NUM_CANDIDATES):
            row_sum += ballot[row][col]
        sum_of_rows[row] = row_sum
    return sum_of_rows

def sum_vectors(vectors: list[Array]) -> Array:
    """ Sum a list of secret-shared integer arrays element-wise.
    
    :param vectors: A list of secret-shared integer arrays.
    :return: A single secret-shared integer array representing the element-wise sum.
    """
    result = Array(NUM_CANDIDATES, sint)
    result.assign_all(sint(0))
    
    for i in range(NUM_CANDIDATES):
        for vector in vectors:
            result[i] += vector[i]
    return result

def majority(vector: Array) -> tuple[sint, Array]:
    """ Determine if any candidate has a majority and return the winner.
    :param vector: A secret-shared integer array representing candidate vote counts.
    :return: A tuple (has_majority, input) where has_majority is a secret-shared bit indicating if a candidate has majority, and winner_vector is a secret-shared bit array indicating the winning candidate.
    """
    has_majority = sint(0)
    @for_range(NUM_CANDIDATES)
    def _(i): 
        condition = (vector[i] > sint(NUM_VOTES // 2))
        has_majority = condition.if_else(has_majority + sint(1), has_majority + sint(0))

    return has_majority, vector

def find_winner(vector: Array) -> sint:
    """ Find the candidate with the highest votes.
    :param vector: A secret-shared integer array representing candidate vote counts.
    :return: The candidate ID (sint) with the highest votes.
    """
    winner_id = sint(-1)

    @for_range(NUM_CANDIDATES)
    def _(i):
        is_winner = (vector[i] > sint(NUM_VOTES // 2))
        winner_id.update(is_winner.if_else(sint(i), winner_id))

    return winner_id

def reveal_winner(winner_id: sint) -> int:
    """ Reveal the winning candidate ID to all parties.
    :param winner_id: The candidate ID (sint) to reveal.
    :return: The revealed candidate ID as an integer.
    """
    return winner_id.reveal()

def update_eliminated_candidates(vector: Array, active_candidates: Array) -> Array:
    """ Find the candidate with the lowest votes among active candidates.

    If there is a tie for lowest votes, the candidate with the lowest index is eliminated.

    :param vector: A secret-shared integer array representing candidate vote counts.
    :param active_candidates: A list of 0/1 secret-shared bits indicating active candidates.
    :return: A secret-shared bit array indicating the eliminated candidate.
    """
    smallest_value = sint(NUM_VOTES + 1)
    smallest_index = sint(-1)

    @for_range(NUM_CANDIDATES)
    def _(i):
        # if active_candidates[i] == 1 => vector[i] = vector[i]
        # if active_candidates[i] == 0 => vector[i] = (NUM_CANDIDATES + 1) (large number)
        adjusted_value = vector[i] + (sint(1) - active_candidates[i]) * sint((NUM_CANDIDATES + 1))
        is_smallest = (adjusted_value < smallest_value)
        smallest_value.update(is_smallest.if_else(adjusted_value, smallest_value))
        smallest_index.update(is_smallest.if_else(sint(i), smallest_index))

    return eliminate_candidate(active_candidates, smallest_index)

def copy_matrix(matrix: Matrix) -> Matrix:
    new_m = Matrix(NUM_CANDIDATES, NUM_CANDIDATES, value_type=sint)
    @for_range(NUM_CANDIDATES)
    def _(i):
        @for_range(NUM_CANDIDATES)
        def _(j):
            new_m[i][j] = matrix[i][j]
    return new_m

def run_protocol():
    """ Run the RCV protocol. """
    ballots = read_all_ballots()
    print_ln_to(0, '%s ballots created.', len(ballots))

    active_candidates = initialize_active_candidates()
    winner = -1

    # Do a round
    for round in range(NUM_CANDIDATES):
        round_ballots: list[Matrix] = [copy_matrix(b) for b in ballots]
        row_sums_array: list[Array] = []
        debug_print(active_candidates, "Active candidates at start of round")
        for ballot_id in range(NUM_VOTES):
            round_ballots[ballot_id] = remove_eliminated_candidates(round_ballots[ballot_id], active_candidates)
            round_ballots[ballot_id] = remove_non_highest_priority(round_ballots[ballot_id])
            row_sums = sum_rows(round_ballots[ballot_id])
            row_sums_array.append(row_sums)
        vote_vector = sum_vectors(row_sums_array)
        vote_vector_copy = vote_vector[:]
        debug_print(vote_vector, f"Vote vector at end of round {round}")

        if round < NUM_CANDIDATES - 1:
            active_candidates = update_eliminated_candidates(vote_vector, active_candidates)
        else:
            # Last round, find and reveal the winner
            winner_id = find_winner(vote_vector)
            winner = winner_id.reveal()
    return winner


def debug_print(secret_stuff, msg="Debug"):
    if not is_debug:
        return
    to_reveal = secret_stuff[:]
    print_ln_to(0, '%s: %s', msg, to_reveal.reveal())

# Main function must be the lowest in the file!!!
def rcv_main():
    """Main function to create and process a secret-shared ballot matrix."""
    winner = run_protocol()
    print_ln_to(0, 'The winning candidate is: %s', winner)


def main():
    #rcv_main()
    shamir_shared_ballots = read_ballots_alt()
    for matrix in shamir_shared_ballots:
        debug_print(matrix, "Shamir shared ballot matrix")


# Make sure to call !!!
# Run it using ./compile.py My_scripts/rcv_matrix.mpc && Scripts/mascot.sh rcv_matrix -N 3 -IF My_scripts/Player-Data/matrix

main()