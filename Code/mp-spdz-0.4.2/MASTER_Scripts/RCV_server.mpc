from Compiler.types import *
from Compiler.GC.types import *
from Compiler.library import *

import MASTER_Scripts.RCV_receive_ballots as RCV_receive_ballots
import MASTER_Scripts.RCV_tally_no_leak as RCV_tally_no_leak
import MASTER_Scripts.RCV_tally_round_leak as RCV_tally_round_leak

from MASTER_Scripts.consts import *

program.active = True  # type: ignore
program.use_edabit(True)    # type: ignore


def run_tally(ballots: list[Array]) -> sint | cint:
    if RUN_LEAK_VERSION:
        print_ln("⚠️ Running tally with round leak version (leaks round-by-round votes to all parties)")
        return RCV_tally_round_leak.tally(ballots)
    else:
        print_ln("🔒 Running tally with no leak version (does not leak round-by-round votes)")
        return RCV_tally_no_leak.tally(ballots)

def main():
    
    timer_send_and_receive_ballots = start_timer(timer_id=TIMER_IDS["send_and_receive_ballots"])
    ballots = RCV_receive_ballots.receive_ballots()
    print_ln("🧾 Received %s ballots", len(ballots))
    stop_timer(timer_id=TIMER_IDS["send_and_receive_ballots"])

    timer_tally = start_timer(timer_id=TIMER_IDS["tally"])
    winner = run_tally(ballots)
    stop_timer(timer_id=TIMER_IDS["tally"])
    print_ln("🏆 Winner is candidate ID: %s", winner.reveal())
    
main()
