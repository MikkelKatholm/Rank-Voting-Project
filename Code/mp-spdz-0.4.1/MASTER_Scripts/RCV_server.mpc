from Compiler.types import *
from Compiler.GC.types import *
from Compiler.library import print_ln, do_while, for_range
from Compiler.util import if_else
from dotenv import load_dotenv
import os

load_dotenv("consts.env")

PORTNUM = int(os.getenv("PORTNUM"))
MAX_NUM_CLIENTS = int(os.getenv("NUM_VOTERS")) + 1 
NUM_CANDS = int(os.getenv("NUM_CANDS"))
n_threads = 4
DEBUG = bool(int(os.getenv("DEBUG")))


program.active = True

def accept_client():
    client_socket_id = accept_client_connection(PORTNUM)
    last = regint.read_from_socket(client_socket_id)
    return client_socket_id, last

def close_all_connections(number_clients):
    @for_range(number_clients)
    def _(i):
        closeclientconnection(i)

def client_input(client_socket_id) -> list[sint]:
    """
    Send share of random value, receive input and deduce share.
    """
    return sint.receive_from_client(NUM_CANDS * NUM_CANDS, client_socket_id)

def debug_print(secret_ballot):
    if DEBUG:
        return
    for elem in secret_ballot:
        clear_val = elem.reveal()
        print_ln('%s', clear_val)

def run_client_server() -> list[list[sint]]: 
    listen_for_clients(PORTNUM)
    print_ln("Listening for client connections on base port %s", PORTNUM)

    client_sockets = Array(MAX_NUM_CLIENTS, regint)
    number_clients =  MemValue(regint(0))
    seen = Array(MAX_NUM_CLIENTS, regint)
    seen.assign_all(0)

    flat_ballots: list[list[sint]] = []

    @do_while
    def _():
        client_id, last = accept_client()
        client_sockets[client_id] = client_id
        seen[client_id] = 1
        @if_(last == 1)
        def _():
            number_clients.write(client_id + 1)
        return (sum(seen) < number_clients) + (number_clients == 0)
    
    def run():
        @for_range(number_clients)
        def _(client_id):
            ballot_sint = client_input(client_id)
            print_ln("📬 Received ballot from client %s", client_id)
            flat_ballots.append(ballot_sint)
            debug_print(ballot_sint)

            closeclientconnection(client_id)
    run()
    return flat_ballots

def format_ballots(flat_ballots: list[list[sint]]) -> list[Matrix]:
    """
    Convert the flat list of ballots into a list of matrices.
    Each ballot is expected to be a flat list of length NUM_CANDS * NUM_CANDS.
    """
    formatted_ballots: list[Matrix] = []
    for ballot in flat_ballots:
        matrix_ballot = Matrix(NUM_CANDS, NUM_CANDS, value_type=sint)
        for col in range(NUM_CANDS):
            for row in range(NUM_CANDS):
                matrix_ballot[col][row] = ballot[col * NUM_CANDS + row]
        formatted_ballots.append(matrix_ballot)
    return formatted_ballots

def print_matrix(matrix: Matrix):
    clear_list = matrix.reveal_list()
    size = int(len(clear_list) ** 0.5)
    for row in range(size):
        row_vals = clear_list[row * size:(row + 1) * size]
        print_ln("%s", row_vals)
        

def main():
    flat_ballots = run_client_server()
    print_ln("✅ All ballots received. Total clients: %s", len(flat_ballots))
    ballots = format_ballots(flat_ballots)
    print_ln("📊 Formatted ballots, got %s ballots", len(ballots))
    for i, ballot in enumerate(ballots):
        print_ln("Ballot %s:", i)
        print_matrix(ballot)

main()
