from My_scripts2.consts import *
from Compiler.library import *

N_THREADS = 4

def accept_client():
    client_socket_id = accept_client_connection(PORT_NUM)
    last = regint.read_from_socket(client_socket_id)
    return client_socket_id

def close_connection(num_clients):
    @for_range(num_clients)
    def _(i):
        closeclientconnection(i)

def get_client_input(client_socket_id):
    # Receive NUM_CANDIDATES^2 secret inputs from client
    flat_values = sint.receive_from_client(1, client_socket_id,
                                           size=NUM_CANDIDATES * NUM_CANDIDATES)

    # Create matrix
    matrix = Matrix(NUM_CANDIDATES, NUM_CANDIDATES, sint)

    for row in range(NUM_CANDIDATES):
        for col in range(NUM_CANDIDATES):
            matrix[row][col] = flat_values[row * NUM_CANDIDATES + col]

    return matrix

def main():
    listen_for_clients(PORT_NUM)
    
    def do_stuff():
        client_sockets = Array(NUM_CLIENTS, regint)

        # Accept connections from clients
        @for_range(NUM_CLIENTS)
        def _(client_id):
            client_sockets[client_id] = accept_client()

        client_matrices = [None] * NUM_CLIENTS
        @for_range(NUM_CLIENTS)
        def _(client_id):
            client_matrix = get_client_input(client_sockets[client_id])
            client_matrices[client_id] = client_matrix

        #reveal all matrices
        @for_range(NUM_CLIENTS)
        def _(client_id):
            client_matrix = client_matrices[client_id]
            client_matrix.reveal()
            print_ln(f"Client {client_id} matrix: {client_matrix}")


        run()
        close_connection(NUM_CLIENTS)

        return True
    
    do_stuff()

main()